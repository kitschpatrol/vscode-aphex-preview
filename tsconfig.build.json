{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"rootDir": "src",
		"module": "Node16",
		"types": ["node"],
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedParameters": true,
		"outDir": "dist",
		"sourceMap": true
	},
	"include": ["src/"]
}
